rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function createsOwnDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // Private teacher data. Queries are constrained in the app by userId.
    match /artifacts/super-tracker-default/public/data/{collection}/{documentId} {
      allow create: if createsOwnDocument();
      allow read, update, delete: if ownsDocument();
    }

    // Published class summaries are readable from a share link, but only the
    // original teacher may create, change, or remove their class's document.
    match /artifacts/super-tracker-default/publicData/{classId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
